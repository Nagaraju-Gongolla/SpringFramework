    <!-- Collection Secondery type DI-->
    <bean id="ans1" class="com.nag.beans.dibeans.Answers">
        <property name="id" value="1" />
        <property name="name" value="java is programming language" />
        <property name="by" value="nag" />
    </bean>

    <bean id="ans2" class="com.nag.beans.dibeans.Answers">
        <property name="id" value="2" />
        <property name="name" value="java is a platform" />
        <property name="by" value="king" />
    </bean>

    <bean id="q" class="com.nag.beans.dibeans.Question">
        <property name="id" value="111" />
        <property name="qname" value="What is java?" />
        <property name="answers">
            <!-- <list>
                <ref bean="ans1" />
                <ref bean="ans2" />
            </list> -->
            <set>
                <ref bean="ans1" />
                <ref bean="ans2" />
            </set>
        </property>
    </bean>

