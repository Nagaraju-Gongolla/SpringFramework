    <bean id="e1" class="com.nag.beans.dibeans.Engine">
        <property name="modelyear" value="2013" />
    </bean>
    <bean id="e2" class="com.nag.beans.dibeans.Engine">
        <property name="modelyear" value="2014" />
    </bean>
    <bean id="e3" class="com.nag.beans.dibeans.Engine">
        <property name="modelyear" value="2015" />
    </bean>
    <bean id="car" class="com.nag.beans.dibeans.ArrayDI">
        <property name="carnames">
            <list>
                <value>Honda</value>
                <value>Benz</value>
                <value>Audi</value>
            </list>
        </property>
        <property name="enginenames">
            <list>
                <ref bean="e1" />
                <ref bean="e2" />
                <ref bean="e3" />
            </list>
        </property>
    </bean>

